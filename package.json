{
  "name": "makeke",
  "author": "hunsangjo",
  "description": "마케팅 자동화 에이전트 - 블로그, 카드뉴스, 영상, 인스타그램",
  "main": "electron/main.js",
  "scripts": {
    "server": "cd api && go run ./cmd/makeke-server --port 8818",
    "server:go": "cd api && go run ./cmd/makeke-server --port 8818",
    "build:go-api": "cd api && mkdir -p bin && go build -o ./bin/makeke-server-go ./cmd/makeke-server",
    "start": "electron .",
    "dev": "electron . --dev --remote-debugging-port=9222 --remote-allow-origins=*",
    "auto": "bash ./scripts/start_makeke.sh",
    "build": "bash ./scripts/build.sh",
    "build:mac": "bash ./scripts/build.sh",
    "build:win": "bash ./scripts/build-win.sh portable",
    "build:win:full": "bash ./scripts/build-win.sh full",
    "build:raw": "electron-builder",
    "test:e2e:electron": "node ./tests/e2e/live-electron-smoke.cjs",
    "test:e2e:electron:live": "node ./tests/e2e/live-electron-smoke.cjs",
    "test:e2e:electron:isolated": "wdio run ./tests/e2e/wdio.electron.conf.cjs",
    "test:launcher-auth": "node ./tests/launcher-auth-contract.test.cjs"
  },
  "build": {
    "appId": "com.makeke.app",
    "productName": "Makeke",
    "asar": false,
    "asarUnpack": [
      "api/**/*",
      "automation/**/*",
      "static/**/*",
      "templates/**/*",
      "chrome-extension/**/*",
      "config.example.ini",
      "modules/**/*"
    ],
    "compression": "maximum",
    "artifactName": "makeke-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "makeke-server/**/*",
      "api/**/*",
      "static/**/*",
      "templates/**/*",
      "automation/**/*",
      "chrome-extension/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "vendor/bun/**/*",
      "config.example.ini",
      "modules/**/*",
      "!static/launcher.html",
      "!static/xiaohongshu.html",
      "!static/kekelink.html",
      "!static/logos/insight-logo.svg",
      "!static/logos/kekelink-logo.svg",
      "!static/logos/seller-booster-logo.svg",
      "!static/logos/shorts-captain-logo.svg"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "electron/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@langchain/core": "^1.1.41",
    "@langchain/langgraph": "^1.2.9",
    "electron-is-dev": "^2.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^5.4.1",
    "wdio-electron-service": "^9.2.1",
    "webdriverio": "^9.27.0"
  },
  "version": "1.7.91",
  "license": "MIT"
}
